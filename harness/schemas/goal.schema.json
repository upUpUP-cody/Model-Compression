{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://model-compression.local/harness/schemas/goal.schema.json",
  "title": "CompressionGoal",
  "type": "object",
  "required": ["goal"],
  "properties": {
    "goal": {
      "type": "object",
      "required": ["model", "quality", "compression", "search"],
      "properties": {
        "model": {
          "type": "object",
          "required": ["path"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "name": { "type": "string" },
            "dtype": { "type": "string", "default": "bf16" },
            "num_layers": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": true
        },
        "hardware": {
          "type": "object",
          "properties": {
            "gpu": { "type": "string" },
            "num_gpu": { "type": "integer", "minimum": 1, "default": 1 }
          },
          "additionalProperties": true
        },
        "quality": {
          "type": "object",
          "required": ["mode", "max_relative_drop"],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "near_lossless",
                "lossless",
                "lossy_bounded",
                "budgeted_drop",
                "pareto"
              ],
              "description": "lossless≈≤1% drop; lossy_bounded≈≤5% drop"
            },
            "max_relative_drop": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Relative drop vs dense primary metric; e.g. 0.05 = 5%"
            },
            "tasks": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": true
        },
        "compression": {
          "type": "object",
          "required": ["ratio_required"],
          "properties": {
            "ratio_required": {
              "type": "boolean",
              "description": "If false, no minimum compression ratio"
            },
            "prefer": {
              "type": "string",
              "enum": ["milder_first", "aggressive_first"],
              "default": "milder_first"
            },
            "min_ratio": { "type": "number", "minimum": 1 }
          },
          "additionalProperties": true
        },
        "search": {
          "type": "object",
          "properties": {
            "auto": { "type": "boolean" },
            "max_trials": { "type": "integer", "minimum": 1, "maximum": 200 },
            "max_rounds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "description": "Iterative short-step rounds"
            },
            "step_policy": {
              "type": "string",
              "enum": ["milder_first", "short_layer"],
              "default": "short_layer"
            },
            "stop_on_violation": {
              "type": "string",
              "enum": ["revert_last_good", "stop_only"],
              "default": "revert_last_good"
            },
            "plugins_order": {
              "type": "array",
              "items": { "type": "string", "enum": ["prune", "quantize"] },
              "description": "Per-round plugin kinds; empty means alternate one plugin per round"
            },
            "max_layers_per_step": { "type": "integer", "minimum": 1, "maximum": 8, "default": 2 },
            "max_sparsity_delta": { "type": "number", "minimum": 0.01, "maximum": 0.2, "default": 0.05 },
            "min_weight_bits": { "type": "integer", "minimum": 2, "maximum": 16, "default": 8 }
          },
          "additionalProperties": true
        },
        "evaluation": {
          "type": "object",
          "properties": {
            "tasks": {
              "type": "array",
              "items": { "type": "string" }
            },
            "primary_metric": { "type": "string" },
            "limit": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
